+
+
+async def validator_node(
+    state: PipelineState,
+    meta: LLMCallMeta,
+    *,
+    score_threshold: float = 3.0,   # config 정본 — 드라이버가 주입
+    call_llm_fn=call_llm,
+    settings=None,
+    judge_model: str = MODEL_JUDGE,   # per-request 선택(ADR-0023). 기본 = MODEL_JUDGE(폴백 env 반영)
+    cross_judge_model_id: str | None = None,   # ADR-0033 consensus-min cross judge (None=현행 byte-identical)
+) -> PipelineState:
+    """LLM 5축 채점 → 백엔드 환산 → state.scores + state.threshold_pass 기록.
+
+    ★ consensus-min (ADR-0033, gated): cross_judge_model_id 주입 시 in-provider judge 통과 후
+    **다른 provider** judge로 재검 → 둘 다 통과해야 pass(더 엄격, 단조). None(default)=in-provider
+    단일 = 현행 byte-identical. F8(JSON 붕괴) 시 cross 미실행(과소검출 안전).
+    """
+    meta.prompt_version = PROMPT_VERSION
+    in_passed, in_block = await _run_judge(
+        state, judge_model, call_llm_fn=call_llm_fn, settings=settings,
+        meta=meta, score_threshold=score_threshold,
+    )
+    passed = in_passed
+    state.scores = in_block
+
+    # consensus-min: cross-provider judge 추가 → AND(더 엄격, 단조). 키/모델 부재면 None 전달 = skip.
+    if cross_judge_model_id and "error" not in in_block:
+        cross_passed, cross_block = await _run_judge(
+            state, cross_judge_model_id, call_llm_fn=call_llm_fn, settings=settings,
+            meta=meta, score_threshold=score_threshold,
+        )
+        passed = in_passed and cross_passed
+        state.scores = {
+            **in_block,
+            "consensus_min": True,
+            "in_provider_pass": in_passed,
+            "cross_pass": cross_passed,
+            "cross_judge_model": cross_judge_model_id,
+            "cross_block": cross_block,
+            "threshold_pass": passed,
+        }
+
+    state.threshold_pass = passed
     return state
diff --git a/app/llm/models.py b/app/llm/models.py
index 308d69a..e354afb 100644
--- a/app/llm/models.py
+++ b/app/llm/models.py
@@ -91,3 +91,27 @@ PROVIDER_ENV = {
     "openai": "OPENAI_API_KEY",         # Tier 0: 임베딩 / Tier 1: gpt-5-nano
     "gemini": "GOOGLE_AI_API_KEY",      # Tier 1: gemini-2.5-flash
 }
+
+
+# ── ADR-0033: cross-provider judge (consensus-min, gated) ──────────────
+# D1-C 재고 — Dreammate 측정(in-provider judge false-approve 10/10, cross 0/10, ko 사람정렬)으로
+# ADR-0031 "B로 cross-model 편향 남으면 재고" 트리거 충족. default off=현행 byte-identical.
+CROSS_JUDGE_ENABLED = os.getenv("CRITIC_CROSS_JUDGE", "").strip().lower() in ("1", "true", "on")
+
+# 생성 provider 와 *다른* provider 의 flagship 을 cross judge 로 (blind-spot 교차).
+_CROSS_JUDGE: dict[str, str] = {
+    "openai": MODEL_JUDGE_OPUS,          # gpt 트랙 → Claude Opus
+    "gemini": MODEL_JUDGE_OPUS,          # gemini 트랙 → Claude Opus
+    "anthropic": "openai/gpt-4o",        # claude 트랙 → GPT-4o
+}
+
+
+def cross_judge_model(provider: str | None) -> str | None:
+    """provider 별 cross-provider judge 모델 (CROSS_JUDGE_ENABLED 일 때만). None=미적용/graceful.
+
+    consensus-min: 드라이버가 이 값을 validator_node(cross_judge_model_id=...)로 전달.
+    flag off / provider 미상이면 None → cross 미실행 = 현행.
+    """
+    if not CROSS_JUDGE_ENABLED or not provider:
+        return None
+    return _CROSS_JUDGE.get(provider)
diff --git a/tests/test_validator_node.py b/tests/test_validator_node.py
index b8e1e60..6de23e4 100644
--- a/tests/test_validator_node.py
+++ b/tests/test_validator_node.py
@@ -256,3 +256,44 @@ async def test_node_temperature_zero():
     await validator_node(_state_with_candidates(), META, call_llm_fn=_fn)
     assert captured["temperature"] == 0.0   # ADR-0007 재현성
     assert captured["model"] == MODEL_JUDGE
+
+
+# ── ADR-0033 consensus-min (cross-provider judge) ──
+_CROSS = "anthropic/claude-opus-4-8"
+_HIGH = json.dumps({"scores": [{"candidate_idx": 0, "layer1_json": SPEC_L1, "layer2a_json": SPEC_L2A}]})
+_WEAK_L1 = {"hook": {"a": False}, "structure": {"a": False}, "info": {"a": False}, "feasibility": {"a": False}}
+_LOW = json.dumps({"scores": [{"candidate_idx": 0, "layer1_json": _WEAK_L1,
+                               "layer2a_json": {"want_watch": 1, "scroll_stop": 1, "recall_1week": 1, "use_my_channel": 1}}]})
+
+
+@pytest.mark.asyncio
+async def test_node_consensus_min_cross_fail_blocks():
+    """in-provider pass + cross fail → AND(더 엄격)로 전체 fail."""
+    async def _branch(**kw):
+        text = _LOW if kw.get("model") == _CROSS else _HIGH
+        return LLMResult(text=text, model_name=kw.get("model"), model_temperature=0.0,
+                         max_tokens=1000, input_tokens=1, output_tokens=1, latency_ms=1, cost_usd=0.0)
+    # in-provider judge_model 을 cross 와 다른 모델로 명시(default MODEL_JUDGE 가 Opus=_CROSS 일 수 있음)
+    st = await validator_node(_state_with_candidates(), META, score_threshold=3.0,
+                              judge_model="openai/gpt-4o", call_llm_fn=_branch, cross_judge_model_id=_CROSS)
+    assert st.threshold_pass is False            # consensus-min = AND → cross fail → 전체 fail
+    assert st.scores["consensus_min"] is True
+    assert st.scores["in_provider_pass"] is True  # in-provider 단독은 pass였음
+    assert st.scores["cross_pass"] is False
+
+
+@pytest.mark.asyncio
+async def test_node_consensus_min_both_pass():
+    """둘 다 pass → pass(약화 0, 단조)."""
+    st = await validator_node(_state_with_candidates(), META, score_threshold=3.0,
+                              call_llm_fn=_mock(_HIGH), cross_judge_model_id=_CROSS)
+    assert st.threshold_pass is True
+    assert st.scores["consensus_min"] is True and st.scores["cross_pass"] is True
+
+
+@pytest.mark.asyncio
+async def test_node_no_cross_byte_identical():
+    """cross_judge_model_id=None(default) → 단일 judge, consensus_min 키 없음(현행)."""
+    st = await validator_node(_state_with_candidates(), META, score_threshold=3.0, call_llm_fn=_mock(_HIGH))
+    assert st.threshold_pass is True
+    assert "consensus_min" not in st.scores
