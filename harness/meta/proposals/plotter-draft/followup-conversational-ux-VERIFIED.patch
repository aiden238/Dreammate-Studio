diff --git a/web/components/follow-up-composer.tsx b/web/components/follow-up-composer.tsx
new file mode 100644
index 0000000..986125e
--- /dev/null
+++ b/web/components/follow-up-composer.tsx
@@ -0,0 +1,90 @@
+"use client";
+
+/**
+ * Phase 34 S2 (cross-project 수렴) — 대화형 follow-up 입력.
+ *
+ * 결과 카드(done)를 보고 "재생성(같은 입력)"만 가능하던 종료 화면에, 프롬프트로 계속 이어갈 수
+ * 있게 한다. 추가 요청을 보내면 새 기획안 묶음이 아래에 쌓인다(page.tsx가 스레드 누적).
+ *
+ * Dreammate 측 FollowUpComposer 와 대칭(양 web 앱 수렴). 표현 계층 전용.
+ */
+
+import { useState } from "react";
+import { CornerDownLeft } from "lucide-react";
+import { Button } from "@/components/ui/button";
+
+interface FollowUpComposerProps {
+  onSubmit: (text: string) => void;
+  loading: boolean;
+  error?: string | null;
+}
+
+const HINTS = ["더 짧게(30초)", "다른 후크로", "더 위트있게", "다른 컨셉도"];
+
+export function FollowUpComposer({ onSubmit, loading, error }: FollowUpComposerProps) {
+  const [text, setText] = useState("");
+
+  function submit() {
+    const t = text.trim();
+    if (!t || loading) return;
+    onSubmit(t);
+    setText("");
+  }
+
+  return (
+    <section
+      aria-label="이어서 요청하기"
+      className="flex flex-col gap-2 rounded-xl border bg-card p-4 shadow-sm"
+    >
+      <div className="flex items-center gap-2 text-sm font-semibold">
+        <span className="h-4 w-1 rounded-full bg-warning" aria-hidden />
+        이어서 요청하기
+      </div>
+      <p className="text-xs text-muted-foreground">
+        마음에 드는 카드를 고른 뒤, 수정·추가 요청을 입력하면 이어서 새 기획안을 만들어요.
+      </p>
+
+      <div className="flex items-end gap-2">
+        <textarea
+          value={text}
+          onChange={(e) => setText(e.target.value)}
+          onKeyDown={(e) => {
+            if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
+              e.preventDefault();
+              submit();
+            }
+          }}
+          disabled={loading}
+          rows={2}
+          placeholder="예: 더 짧게 / 다른 후크 / 다른 컨셉도"
+          aria-label="추가 요청 입력"
+          className="flex-1 resize-none rounded-md border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-60"
+        />
+        <Button type="button" onClick={submit} disabled={loading || text.trim().length === 0}>
+          <CornerDownLeft aria-hidden />
+          {loading ? "생성 중…" : "이어가기"}
+        </Button>
+      </div>
+
+      <div className="flex flex-wrap gap-1.5">
+        {HINTS.map((h) => (
+          <button
+            key={h}
+            type="button"
+            disabled={loading}
+            onClick={() => setText(h)}
+            className="rounded-full border px-2.5 py-1 text-xs text-muted-foreground hover:bg-accent disabled:opacity-50"
+          >
+            {h}
+          </button>
+        ))}
+      </div>
+
+      {error && (
+        <p role="alert" className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-xs text-destructive">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}
