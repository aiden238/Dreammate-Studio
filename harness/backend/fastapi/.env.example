# Dreammate Studio — FastAPI Backend Environment
# 사용법: cp .env.example .env 후 실제 키 입력

# ─── LLM ───────────────────────────────────────────
OPENAI_API_KEY=sk-...                # 필수. 발급: https://platform.openai.com/api-keys
OPENAI_MODEL_DEFAULT=gpt-4o-mini     # Intent + Planning
OPENAI_MODEL_CRITIC=gpt-4o           # Critic (Slice 3 사용)

# ─── Phase 4 Slice 2: 3-plan multi-model (사용자 결정 4-b) ────────────
# 향후 모델 추가 가능 (Anthropic / Google 등은 Phase 21+, Phase 4는 OpenAI만)
# default: 동일 모델 × 3 (cost 효율 — 1 호출 vs 3 호출 차이 약 3x cost지만 parallel로 latency 동일)
# OPENAI_MODELS_FOR_3PLAN=gpt-4o-mini,gpt-4o-mini,gpt-4o-mini

# ─── App ───────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── CORS (Slice 6 이후 활성화) ────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── pgvector (Slice 4 활성화) ──────────────────────
# 미설정 시 RAG 검색은 자동으로 graceful fallback (빈 references + 200 응답)
# Phase 1 acceptance: pgvector 미연결 상태에서도 정상 동작 보장
# PGVECTOR_DATABASE_URL=postgresql://user:pass@host:5432/dbname
PGVECTOR_TABLE=rag_chunks
PGVECTOR_TOP_K=3
PGVECTOR_THRESHOLD=0.7

# ─── Supabase / DB (Slice 5 활성화) ────────────────
# 미설정 시 DB 저장은 자동으로 graceful skip (meta.project_id=null + 200 응답).
# Phase 1 acceptance: DB 미연결 상태에서도 사용자 차단 0건.
# DATABASE_URL과 PGVECTOR_DATABASE_URL을 동일 Postgres로 통합 운영도 가능.
# 분리하려면 PGVECTOR_DATABASE_URL만 별도 cluster로 지정.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_KEY=...   # ★ server-side RLS 우회 (Phase 17 PKM/brand_memory write 필수).
#                            #   get_supabase() 가 있으면 우선 사용. frontend 절대 노출 금지(NEXT_PUBLIC_* 금지).
# DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

# ─── Phase 17 PKM 게이트 (Supabase + 인증 사용자에서 실동작) ─────────
# 기본 OFF — 켜야 PKM 주입/추출 동작 (없으면 byte-identical).
# PERSONAL_PKM_INJECTION_ENABLED=true
# PERSONAL_PKM_EXTRACT_ENABLED=true
# BRAND_MEMORY_INJECTION_ENABLED=true
# BRAND_MEMORY_EXTRACT_ENABLED=true
