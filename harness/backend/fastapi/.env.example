# Dreammate Studio — FastAPI Backend Environment
# 사용법: cp .env.example .env 후 실제 키 입력

# ─── LLM ───────────────────────────────────────────
OPENAI_API_KEY=sk-...                # 필수. 발급: https://platform.openai.com/api-keys
OPENAI_MODEL_DEFAULT=gpt-4o-mini     # Intent + Planning
OPENAI_MODEL_CRITIC=gpt-4o           # Critic (Slice 3 사용)

# ─── App ───────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── CORS (Slice 6 이후 활성화) ────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Supabase (Slice 5 이후 활성화) ────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...
# DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

# ─── pgvector (Slice 4 이후 활성화) ────────────────
# PGVECTOR_TABLE=knowledge_chunks
# PGVECTOR_TOP_K=3
# PGVECTOR_THRESHOLD=0.7
