# Dreammate Studio — 실사용 프로파일 (1차 MVP 실사용 마감, Phase 27 S1 / B-1)
# ============================================================================
# 목적: "처음 온 사용자가 도움 없이 → director 기획안 1개 생성 → 저장 →
#       내 brain 축적 → 다음 기획에 반영" 핵심 루프를 끊김 없이 켠다.
#
# 사용법(택1):
#   (A) 권장 — 단일 스위치: .env 에 APP_PROFILE=realuse 한 줄만 추가.
#       → 아래 핵심 루프 flag 가 코드(config._apply_realuse_profile)에서 자동 ON.
#   (B) 또는 이 파일을 통째로 .env 에 합쳐 개별 flag 를 명시적으로 ON.
#
# ★ 키(OPENAI_API_KEY / SUPABASE_*)는 절대 이 파일에 넣지 말 것 — 실제 .env 에만.
#   이 파일은 example(커밋 가능). 실 키 파일(.env)은 .gitignore.
# ★ 코드 default 는 OFF 유지(테스트 byte-identical). 실사용 활성은 env(이 프로파일)로만.
# ============================================================================

# ─── (A) 권장: 단일 스위치 ───────────────────────────────────────────────
APP_PROFILE=realuse

# ─── (B) 단일 스위치 대신 개별 명시하고 싶을 때 (위 APP_PROFILE 없이) ──────
# 개별 명시는 프로파일보다 우선(override). director 기획안 + PKM 루프를 직접 켠다.
# OUTPUT_MODE=director                  # 첫 기획안 깊이: 연출/리텐션 브리프 (compact<rich<director<commercial_viral)
# RICH_OUTPUT_ENABLED=true              # 레거시 rich 스위치 (output_mode 가 우선이나 호환 위해 함께)
# PLANS_REPO_ENABLED=true               # 생성 plan 을 Supabase 로 영속 (재시작해도 유지). Supabase 키 필요.
# BRAND_MEMORY_INJECTION_ENABLED=true   # 브랜드 PKM 을 다음 생성에 구속 주입
# BRAND_MEMORY_EXTRACT_ENABLED=true     # 피드백 → 브랜드 PKM 자동 축적 (confidence≥0.9)
# PERSONAL_PKM_INJECTION_ENABLED=true   # 개인 PKM 을 다음 생성에 주입 (personal > brand)
# PERSONAL_PKM_EXTRACT_ENABLED=true     # 피드백 → 개인 PKM 자동 축적
# BRANDING_PKM_SEED_ENABLED=true        # 브랜딩 세션 택1 → domain/series + brand PKM 시드

# ─── 전제 (실 영속·인증이 필요한 flag 동작 조건) ──────────────────────────
# - SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY 가 .env 에 설정되어야
#   plan 영속·PKM 축적이 실제 DB 에 기록된다 (미설정 시 graceful — 차단 0, 휘발).
# - migration 0001~0008 이 Supabase 에 적용되어 있어야 한다 (scripts/apply_migrations 참조).
# - PKM 주입/추출은 인증 사용자(JWT 쿠키)에서만 발동 (익명 생성은 byte-identical).

# ─── 비용 주의 ────────────────────────────────────────────────────────────
# director tier 는 compact 대비 토큰이 수배(cost_control_policy.md §16). 실사용 비용 모니터링 권장.
# (선택) 텔레메트리로 토큰/비용 추적: AGENT_IO_LOG_ENABLED=true (agent_io_logs 테이블 필요).
